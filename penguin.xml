  <project path="system/memory/libmeminfo" name="android_system_memory_libmeminfo" remote="penguin-aosp" />
  <project path="system/memory/lmkd" name="android_system_memory_lmkd" remote="penguin-aosp" />
  <project path="system/netd" name="android_system_netd" remote="penguin-aosp" />
