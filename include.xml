<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- Github -->
  <remote  name="github"
           fetch="https://github.com/" />

  <!-- GitHub (StatiXOS) -->
  <remote  name="statix"
           revision="bp4a"
           fetch="https://github.com/StatiXOS/" />

  <!-- GitHub (STX-Staging) -->
  <remote  name="statix-staging"
           revision="cp2a"
           fetch="https://github.com/stx-staging/" />

  <!-- GitHub (PenguinOS on AOSP) -->
  <remote  name="penguin-aosp"
           revision="celerity"
           fetch="https://github.com/PENGUIN_AOSP_ORG/" />

  <!-- GitHub (Project PenguinOS) -->
  <remote  name="penguin"
           revision="celerity"
           fetch="https://github.com/Project-PenguinOS/" />

  <!-- Codeberg -->
  <remote  name="codeberg"
           fetch="https://codeberg.org/" />

  <!-- GitLab -->
  <remote name="gitlab"
           fetch="https://gitlab.com/" />

  <!-- Gitea -->
  <remote  name="gitea"
           fetch="https://git.keksla.wtf/" />

  <!-- ART -->
  <project path="art" name="android_art" remote="statix-staging" />

  <!-- Bionic-->
  <project path="bionic" name="android_bionic" remote="statix-staging" />

  <!-- Build -->
  <project path="build/make" name="android_build" remote="penguin-aosp">
    <copyfile src="core/root.mk" dest="Makefile" />
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="build/soong" name="android_build_soong" remote="penguin-aosp">
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- Device -->
  <project path="device/manifests" name="android_device_manifests" remote="penguin-aosp">
    <linkfile src="build.sh" dest="build.sh" />
  </project>
  <project path="device/statix/sepolicy" name="android_device_statix_sepolicy" remote="statix-staging" revision="cb" />

  <!-- External -->
  <project path="external/gptfdisk" name="android_external_gptfdisk" remote="statix-staging" />
  <project path="external/mksh" name="android_external_mksh" remote="statix-staging" />
  <project path="external/tinycompress" name="android_external_tinycompress" remote="statix-staging" />
  <project path="external/e2fsprogs" name="android_external_e2fsprogs" remote="statix-staging" />
  <project path="external/wpa_supplicant_8" name="android_external_wpa_supplicant_8" remote="statix-staging" />

  <!-- Frameworks -->
  <project path="frameworks/av" name="android_frameworks_av" remote="penguin-aosp" />
  <project path="frameworks/base" name="android_frameworks_base" remote="penguin-aosp" />
  <project path="frameworks/native" name="android_frameworks_native" remote="penguin-aosp" />

  <!-- Hardware -->
  <project path="hardware/google/pixel" name="android_hardware_google_pixel" remote="statix-staging" />
  <project path="hardware/google/pixel-sepolicy" name="android_hardware_google_pixel-sepolicy" remote="statix-staging" />
  <project path="hardware/interfaces" name="android_hardware_interfaces" remote="penguin-aosp" />
  <project path="hardware/libhardware" name="android_hardware_libhardware" remote="statix-staging" />
  <project path="hardware/nxp/nfc" name="android_hardware_nxp_nfc" remote="statix-staging" />
  <project path="hardware/qcom/wlan" name="android_hardware_qcom_wlan" remote="statix-staging" />
  <project path="hardware/lineage/compat" name="LineageOS/android_hardware_lineage_compat" remote="github" revision="lineage-24.0" />
  <project path="hardware/statix/interfaces" name="android_hardware_statix_interfaces" remote="statix" />

  <!-- Kernel -->
  <project path="kernel/configs" name="android_kernel_configs" remote="statix-staging" />

  <!-- Manifest -->
  <project path="manifest" name="android_manifest" remote="penguin-aosp" />

  <!-- Packages -->
  <project path="packages/apps/Aperture" name="LineageOS/android_packages_apps_Aperture" remote="github" revision="lineage-23.2" />
  <project path="packages/apps/Launcher3" name="android_packages_apps_Launcher3" remote="penguin-aosp" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="penguin-aosp" />
  <project path="packages/apps/ThemePicker" name="android_packages_apps_ThemePicker" remote="penguin-aosp" />
  <project path="packages/apps/WallpaperPicker2" name="android_packages_apps_WallpaperPicker2" remote="penguin-aosp" />
  <project path="packages/modules/Bluetooth" name="android_packages_modules_Bluetooth" remote="penguin-aosp" />
  <!--project path="packages/modules/Connectivity" name="android_packages_modules_Connectivity" remote="statix" /-->
  <project path="packages/resources/devicesettings" name="android_packages_resources_devicesettings" remote="statix" />

  <!-- Platform Testing -->
  <project path="platform_testing" name="android_platform_testing" remote="statix-staging" />

  <!-- Prebuilts -->
  <project path="prebuilts/extract-tools" name="android_prebuilts_extract-tools" remote="statix" clone-depth="1" revision="bak" />

  <!-- Recovery -->
  <project path="bootable/recovery" name="android_bootable_recovery" remote="statix-staging" />

  <!-- System -->
  <project path="system/core" name="android_system_core" remote="penguin-aosp" />
  <project path="system/fs/fs_mgr" name="android_system_fs_fs_mgr" remote="statix-staging" />
  <project path="system/libhidl" name="android_system_libhidl" remote="statix-staging" />
  <project path="system/media" name="android_system_media" remote="statix-staging" />
  <project path="system/memory/libion" name="android_system_memory_libion" remote="statix-staging" />
  <project path="system/sepolicy" name="android_system_sepolicy" remote="penguin-aosp" />

  <!-- Tools -->
  <project path="tools/extract-utils" name="LineageOS/android_tools_extract-utils" remote="github" revision="lineage-23.2" />

  <!-- Vendor -->
  <project path="vendor/google/interfaces" name="android_vendor_google_interfaces" remote="statix" />
  <project path="vendor/penguin" name="android_vendor_penguin" remote="penguin-aosp">
    <linkfile src="build/stop_scan.mk" dest="kernel/Android.mk" />
  </project>
</manifest>
